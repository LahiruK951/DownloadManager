{
  "manifest_version": 3,
  "name": "FluxDM",
  "version": "0.3.0",
  "description": "Send your downloads to the FluxDM download manager.",
  "key": "",
  "permissions": ["downloads", "nativeMessaging", "contextMenus", "cookies", "storage", "webRequest", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FluxDM",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}